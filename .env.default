# =====================================================================
# CISTAFIRMA - CENTRALIZED ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and adjust values for your environment
# This file is the single source of truth for all configurations

# =====================================================================
# 🌐 FRONTEND CONFIGURATION
# =====================================================================
# Frontend development server
FRONTEND_PORT=5173
FRONTEND_HOST=localhost

# API Configuration for frontend (points to backend)
# In development, Vite proxy uses this to forward API requests
FRONTEND_API_URL=/api
# Note: when frontend runs in Docker, docker-compose overrides proxy target to backend:8000.

# =====================================================================
# 🔙 BACKEND CONFIGURATION (Django)
# =====================================================================
# Backend API port (exposed from Docker to host machine)
# Docker container runs on 8000, but is exposed to host on this port
BACKEND_PORT=8080
BACKEND_HOST=localhost
BACKEND_WORKERS=2
BACKEND_THREADS=4

# Host interface the backend and frontend ports are published on.
# 127.0.0.1 (default) = reachable only from this machine. Set to 0.0.0.0 to
# expose the stack to the LAN -- that also exposes the whole API, the Django
# admin and /metrics to every device on the network, including the Vite proxy
# on the frontend port, so change it only deliberately.
# db and redis are always loopback-bound and are not affected by this.
# BIND_HOST=127.0.0.1

# Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
# Logging (Phase 3): LOG_LEVEL in DEBUG|INFO|WARNING|ERROR|CRITICAL.
# LOG_FORMAT=json -> structured one-JSON-object-per-line to stdout;
# LOG_FORMAT=text -> classic human-readable lines (local dev escape hatch).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Metrics (Phase 3, pillar 2): METRICS_ENABLED turns the /metrics scrape target
# on or off. The endpoint is never public either way — it answers only loopback
# and private clients, or a caller sending METRICS_TOKEN as `Authorization:
# Bearer <token>` when that variable is set (leave it empty for local use).
METRICS_ENABLED=true
# METRICS_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Email (SMTP) — for notification emails. Defaults to console backend (prints
# emails into backend logs). To send real email, switch EMAIL_BACKEND to SMTP
# and fill in the credentials below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-login@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_FROM=CistaFirma <noreply@cistafirma.sk>

# =====================================================================
# 📊 DATABASE CONFIGURATION (PostgreSQL)
# =====================================================================
# Database credentials (used by both Docker and local connections)
POSTGRES_DB=cistafirma
POSTGRES_USER=cistafirma
POSTGRES_PASSWORD=cistafirma_secret
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# For Docker: uses 'db' as hostname inside the network
# For Local: uses 'localhost' as hostname
# Django connection string - leave empty to use SQLite in local dev
DATABASE_URL=

# For Docker deployment:
# DATABASE_URL=postgres://cistafirma:cistafirma_secret@db:5432/cistafirma

# =====================================================================
# 🔴 REDIS/CELERY CONFIGURATION
# =====================================================================
# Redis port (exposed from Docker)
# Docker container runs on 6379, but is exposed to host on this port
REDIS_PORT=6380
REDIS_HOST=localhost

# Redis requirepass, used by the Docker redis service AND all app connection
# strings (compose interpolates ${REDIS_PASSWORD:-...} in docker-compose.yml).
# MUST be URL-safe: A-Za-z0-9 _ - .  (percent-encode any special chars in URLs).
# If you override it, keep the three URLs below (and the Docker ones) in sync.
REDIS_PASSWORD=cistafirma_redis_secret

# Full Redis connection strings (authed)
REDIS_URL=redis://:cistafirma_redis_secret@localhost:6380/0
CELERY_BROKER_URL=redis://:cistafirma_redis_secret@localhost:6380/0
CELERY_RESULT_BACKEND=redis://:cistafirma_redis_secret@localhost:6380/0

# For Docker deployment:
# REDIS_URL=redis://:cistafirma_redis_secret@redis:6379/0
# CELERY_BROKER_URL=redis://:cistafirma_redis_secret@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:cistafirma_redis_secret@redis:6379/0

# =====================================================================
# 🐳 DOCKER DEPLOYMENT
# =====================================================================
# Optional: Use when deploying with Docker
# Leave as defaults unless you have port conflicts
DOCKER_BACKEND_INTERNAL_PORT=8000
DOCKER_REDIS_INTERNAL_PORT=6379

# =====================================================================
# ⚙️ DEVELOPMENT NOTES
# =====================================================================
#
# LOCAL DEVELOPMENT (Frontend + Docker Backend):
#   1. Copy .env.default → .env
#   2. Start Docker: make docker-up && make docker-migrate   (migrate is NOT auto-run on up)
#   3. Start Frontend: cd frontend && npm run dev
#   4. Access frontend on: http://localhost:5173
#   5. Backend API is accessible at: http://localhost:8080/api/...
#   6. Vite proxy automatically forwards /api requests to backend
#
# IMPORTANT PORT MAPPING:
#   - Backend: Docker internal 8000 → Host 8080
#   - Redis: Docker internal 6379 → Host 6380
#   - Frontend: Local 5173
#   - Database: Docker internal 5432 → Host 5432
#
# DJANGO SETTINGS:
#   - Uses DATABASE_URL when set (PostgreSQL in Docker)
#   - Uses SQLite (db.sqlite3) when DATABASE_URL is empty (local dev)
#   - Celery uses Redis URLs for broker and backend
#
# CORS & CSRF:
#   - Frontend CORS: http://localhost:5173
#   - CSRF trusted origins include localhost and backend service name
#   - In Docker: ALLOWED_HOSTS includes 'backend' service name

