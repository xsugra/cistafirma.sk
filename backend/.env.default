# DEPRECATED: Use root .env.default instead
# This file is kept for backward compatibility only.
#
# The centralized configuration is now at:
# -> ../../.env (copy from ../../.env.default)
#
# Copy root .env.default to root .env:
#   cp ../../.env.default ../../.env
#
# Then Django will automatically load from root .env when starting.
#
# ============ LEGACY CONTENT BELOW (for reference only) ============
#
# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL empty to use SQLite (backend/db.sqlite3).
# DATABASE_URL=postgres://cistafirma:cistafirma_secret@localhost:5432/cistafirma

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

