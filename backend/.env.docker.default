# DEPRECATED: Use root .env.default instead
# This file is kept for backward compatibility only.
#
# The centralized configuration is now at:
# -> ../../.env (copy from ../../.env.default)
#
# Copy root .env.default to root .env:
#   cp ../../.env.default ../../.env
#
# Then Django and Docker will automatically load from root .env.
#
# ============ LEGACY CONTENT BELOW (for reference only) ============
#
# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (used by Django inside Docker)
DATABASE_URL=postgres://cistafirma:cistafirma_secret@db:5432/cistafirma

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# PostgreSQL credentials
POSTGRES_DB=cistafirma
POSTGRES_USER=cistafirma
POSTGRES_PASSWORD=cistafirma_secret

