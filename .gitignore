# =========================================================
# CistaFirma monorepo - global ignore rules
# =========================================================

# OS / editor
.DS_Store
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Python cache / build
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.tox/
.hypothesis/
htmlcov/
.coverage
.coverage.*
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Logs
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
coverage/

# Django runtime artifacts
db.sqlite3
backend/db.sqlite3
media/
backend/staticfiles/

# Celery / Redis runtime artifacts in repo root
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal
celerybeat-schedule.*
dump.rdb
=0.40.0

# Local temp folders
tmp/
worktrees/
old/
backups/

# Sensitive env files
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Keep template/default env files versioned
!.env.default
!backend/.env.default
!backend/.env.docker.default
!frontend/env.default

# Local k8s secrets (never commit real credentials)
deploy/k8s/local-secret.yaml
deploy/k8s/*-secret-local.yaml

# Generated FS data (local fetch artifacts)
backend/data/fs_data/**/*.xml
backend/data/fs_data/**/*.xsd
backend/data/fs_data/**/*.zip

# Keep docs and source files by default (no blanket excludes below)
CLAUDE.md
graphify-out/

# AI generated files and folders
.claude
.github/copilot-instructions.md
code-reviews.md
