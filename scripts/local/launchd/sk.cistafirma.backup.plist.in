<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the weekly CistaFirma backup agent.
  Do not edit the installed copy in ~/Library/LaunchAgents — it is generated by
  scripts/local/install_backup_schedule.sh, which substitutes the placeholders
  below (__ROOT_DIR__, __PATH__, __HOME__).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sk.cistafirma.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>__ROOT_DIR__/scripts/local/scheduled_backup.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd starts agents with a minimal PATH; the installer embeds the
             interactive login PATH so docker/python3 resolve as in the shell. -->
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- Weekly, Sunday 03:17 local time. If the Mac is asleep, launchd runs the
         job shortly after it wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/CistaFirma/backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/CistaFirma/backup.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
