{
  "uid": "cistafirma-operations",
  "title": "CistaFirma Operations",
  "tags": ["cistafirma", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unmet operational verdicts",
      "description": "How many subjects each health gate currently judges as failing. This is the same verdict `make ops-check` reaches: 0 means the gate passed, anything above 0 names a real unmet condition. A blank panel means the exporter is not being scraped -- check 'Ops exporter reachable' below, do not read it as healthy.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_ops_unmet",
          "legendFormat": "{{domain}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Subjects not passing",
      "description": "Every subject whose current verdict is not `ok`, with the reason code the gate recorded. `not_judged` is listed too, and is NOT a failure: it is a source paused by Focus Mode or a window the gate deliberately declined to judge. Reading those as failures is how a monitoring stack starts crying wolf and stops being read.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fail": { "color": "red", "index": 0 },
                      "not_judged": { "color": "text", "index": 1 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_ops_subject{status!=\"ok\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ops exporter reachable / evaluators OK",
      "description": "Two different faults, side by side. `ops exporter` is whether Prometheus can reach the process at all; if it is DOWN, every operational panel on this dashboard is stale, not fine. `evaluators ok` is whether the process could compute its verdicts; if that is DOWN the process is serving happily while a domain (sync, source, beat) raised, so those subjects vanish from the panels above instead of turning red.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "up{job=\"cistafirma-ops\"}",
          "legendFormat": "ops exporter",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_ops_scrape_ok",
          "legendFormat": "evaluators ok",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "How stale each verdict is",
      "description": "Seconds since each domain was actually evaluated, not since it was last scraped. A rising line means the evaluator is wedged or erroring while Prometheus keeps scraping happily -- the exporter's cache would otherwise hide that entirely.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "time() - cistafirma_ops_evaluated_timestamp_seconds",
          "legendFormat": "{{domain}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Celery queue depth",
      "description": "Items waiting per queue. Each queue is a Redis list, so this is the same depth `ops_check.sh` reads with LLEN. Watch the SHAPE: the insurance dispatcher's cap equals its drain rate, so that queue sawtooths by design and its depth is not a leak. A queue that climbs and does not come back down is the signal.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_key_size{key=~\"ruz_full|orsr|financials|insurance|celery\"}",
          "legendFormat": "{{key}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis",
      "description": "Broker memory and connected clients. Redis holds the queues, not the results that matter -- but a broker at its memory limit is a broker that starts evicting or refusing writes, and Celery fails in confusing ways when that happens.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "clients" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memory used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sync job heartbeat age",
      "description": "Seconds since the last heartbeat for each job type that has a run in flight. A RUZ full walk runs for days, so a high but steady value is normal; a value that keeps climbing past the gate's stuck threshold is a worker that died mid-run. The gate itself judges this -- this panel is for seeing it coming.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_sync_job_heartbeat_age_seconds",
          "legendFormat": "{{job_type}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Beat entry age",
      "description": "Seconds since each periodic entry last ran, against its own interval. This is the panel for the failure that leaves no other trace: a task that never fires writes nothing anywhere, so queue depth, source health and sync jobs all stay green while the entry is dead. `compute-sector-benchmarks-daily` did exactly that for 32 hours.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "topk(10, cistafirma_beat_entry_age_seconds)",
          "legendFormat": "{{task}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Source coverage in window",
      "description": "Companies attempted versus succeeded per source, over the gate's window. A widening gap between the two lines is a source that is being asked and failing; both lines collapsing together is a source that stopped being asked at all. The gate judges both -- this shows which one happened.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_source_companies{state=\"attempted\"}",
          "legendFormat": "{{source}} attempted",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "cistafirma_source_companies{state=\"succeeded\"}",
          "legendFormat": "{{source}} succeeded",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Postgres backends",
      "description": "Client connections to the cistafirma database. Postgres has a hard connection ceiling, and Celery workers plus gunicorn threads are what consume it -- a plateau at the limit is how a stack stops accepting work.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pg_stat_database_numbackends{datname=\"cistafirma\"}",
          "legendFormat": "backends",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Postgres database size",
      "description": "On-disk size of the cistafirma database. This is the growth line that says when the disk under irreplaceable data needs attention -- and it is the one number here whose trend never reverses.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pg_database_size_bytes{datname=\"cistafirma\"}",
          "legendFormat": "database size",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Scrape targets",
      "description": "Every configured scrape target, up or down. This panel is deliberately the widest net on the dashboard: a monitoring stack that is itself half-broken reports everything else as fine, and the only thing that contradicts it is this.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
