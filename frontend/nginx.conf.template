# nginx config for the production frontend image.
#
# This is a TEMPLATE, not a finished config: the backend answers to a different
# name in every place this image runs -- `backend` under docker compose,
# `cistafirma-backend` as the Kubernetes Service the kustomize overlays create.
# The official nginx image renders it at container start, from
# /etc/nginx/templates (see the entrypoint's 20-envsubst-on-templates.sh).
# Dockerfile.prod sets NGINX_ENVSUBST_FILTER=BACKEND_ so that only the variables
# named on purpose here are substituted, leaving nginx's own $host / $uri /
# $scheme untouched. The upstream GROUP name below is deliberately not
# BACKEND_-prefixed, so that filter can never reach it.
#
# The backend is reached through an upstream group whose server carries
# `resolve` (open source since nginx 1.27.3, and this image is 1.27.5), so the
# name is resolved at RUN TIME and re-resolved as the answer expires, instead of
# once when nginx starts.
#
# That is the fix for the 2026-09-17 outage, which ran 3h43m and took every API
# call down while /healthz stayed green. nginx had resolved `backend` once, at
# its own start (06:36:54Z), to 172.18.0.5; the backend container was recreated
# 22 seconds later and came back at 172.18.0.11; 172.18.0.5 was then recycled to
# celery_beat, which listens on nothing at :8000 -- so every request died with
# "connect() failed (111: Connection refused)" and answered 502. A static name
# cannot recover from that, and deploy order cannot prevent it: `depends_on`
# says nothing about which container compose recreates afterwards, and a lone
# `docker compose up -d --build backend` moves the address just as well.
#
# Measured twice, and the second measurement corrected the first.
#
# On a throwaway pair of containers reproducing exactly this sequence (target
# started first, both proxy forms started, target recreated, a squatter taking
# the freed address), the old static form answered 502 to every request after the
# recreate and never recovered, while this form recovered within one sampling
# interval. That interval was too coarse to say WHY it recovered, and the note
# first written here claimed the failed connection to the held address triggered
# an early re-resolve. It does not. Production says so.
#
# Re-run on production itself, 2026-09-17, with the frontend container left
# running the whole time and the backend moved off its address (a squatter took
# 172.18.0.11; the backend came back at 172.18.0.14), sampled every 3s through
# the published port:
#
#     t+0s   502        t+9s   502
#     t+3s   502        t+12s  200   <- recovered; frontend never restarted
#     t+6s   502        t+15s  200
#
# The frontend's own log splits that window in two, which is why a single number
# would have been the wrong thing to write down. The backend container was
# recreated at 10:54:18Z; nginx went on dialling the STALE 172.18.0.11 until
# 10:54:25 (nine attempts) and dialled the correct 172.18.0.14 from 10:54:28
# (two attempts). Those last two were refused as well, because the recreated
# backend had not yet opened :8000 -- it was still starting. So the window is
# bounded by TWO things, not one: the DNS lifetime below, which is what held
# nginx on the stale address for ~7s, and then the backend's own start-up, which
# no amount of DNS tuning touches. `valid=` moves only the first. Lower it if a
# shorter outage on backend recreate is ever worth the extra lookups; the lab
# run's faster recovery was this same mechanism landing at a luckier point in
# the DNS window, not an early re-resolve on the failed connection.
#
# Two mistakes stay LOUD, at container start, which is the property the old
# comment here was protecting: omitting the resolver fails with "no resolver
# defined to resolve names at run time in upstream", and substituting it empty
# fails with "no name servers defined". What no longer happens is the old
# refusal to start on "host not found in upstream" -- with `resolve`, nginx
# starts even while the name answers nothing.
#
# BACKEND_RESOLVER is required and, unlike BACKEND_UPSTREAM, is deliberately
# left empty in the image rather than defaulted. It is an address, not a name:
# nginx never consults /etc/resolv.conf for run-time resolution, and there is no
# portable fallback -- 127.0.0.11 is Docker's embedded DNS (docker-compose.prod.yml
# sets it) while Kubernetes answers at its own cluster DNS (10.96.0.10 on a
# kubeadm default, 10.43.0.10 on k3s). A wrong-but-valid address would start
# fine and fail per request, which is the exact silent shape this change removes,
# so the value is required rather than guessed. Dockerfile.prod declares it empty
# so the failure names itself; deploy/k8s and deploy/helm do not set it yet, and
# must before a new frontend image is deployed there.

resolver ${BACKEND_RESOLVER} valid=10s ipv6=off;

upstream backend_upstream {
    # `resolve` needs the group in shared memory. 64k is the size nginx's own
    # example uses; this group holds a single address.
    zone backend_upstream 64k;

    # max_fails=0 disables the passive health check, so nginx never marks this
    # lone peer down and never answers "no live upstreams": every request tries
    # whatever address nginx currently holds. That is the right trade for a group
    # of one -- with the check on, the only peer failing would take the whole
    # group down and answer 503 to everything rather than retry.
    #
    # Its cost is measured, not assumed: because the check is off, a failed
    # connect does NOT trigger a fresh lookup, so a moved address is picked up
    # only when the `valid=` lifetime below expires -- ~7s of stale dialling on
    # production, measured (see the header). Raising max_fails
    # would shorten that and break the group for every request in between, so it
    # stays 0 and `valid=` carries the window.
    server ${BACKEND_UPSTREAM} resolve max_fails=0;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # All three backend locations name the GROUP, which is looked up among the
    # declared upstreams before any DNS is involved. proxy_pass keeps its static
    # no-URI form, so the original request URI is passed upstream unchanged --
    # byte for byte what the three separate literal proxy_pass lines did before.
    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Django admin owns /admin/ -- the whole subtree, so it has to stay a prefix
    # location. But the staff panel in the app is a client-side route at exactly
    # /admin, and nginx matches a prefix location ending in a slash to the bare
    # path too, answering /admin with a 301 to /admin/. In the built image that
    # sent the staff panel to Django and the panel never loaded (the Vite dev
    # server has no /admin/ rule, so this only ever broke in production). An
    # exact match is tested before any prefix location, so it wins over that
    # redirect and serves the app: /admin is the staff panel, /admin/ is Django.
    location = /admin {
        try_files /index.html =404;
    }

    location /static/ {
        alias /usr/share/nginx/html/;
        try_files $uri @backend_static;
    }

    location @backend_static {
        proxy_pass http://backend_upstream;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Liveness of THIS container. deploy/k8s/base/frontend-deployment.yaml wires
    # this path to a livenessProbe, so it deliberately does not reach downstream:
    # a backend outage must not restart every frontend pod.
    #
    # What it must not be is a constant. `return 200 'ok'` reports a healthy
    # container even when there is no built app to serve -- an empty
    # /usr/share/nginx/html serves 404 to every visitor while the probe stays
    # green, which is the one failure this endpoint exists to make visible. It
    # answers 503 unless index.html is there to be served.
    #
    # It is also, by the same design, blind to the 2026-09-17 outage: this
    # container reported healthy for the whole 3h43m in which every API call
    # answered 502. That is the correct trade for a LIVENESS probe -- restarting
    # nginx cannot fix an unreachable backend, and a probe that failed here would
    # restart every frontend pod during any backend restart. It does mean this
    # endpoint is not an availability signal, and nothing else in the stack is
    # either: prometheus.yml provisions no alerting rules, and scripts/local/ops_check.sh
    # probes no frontend. Detecting the next occurrence needs a check that
    # exercises /api/ from outside, not a change to this location.
    location /healthz {
        access_log off;
        default_type text/plain;
        if (!-f /usr/share/nginx/html/index.html) { return 503; }
        return 200 'ok';
    }
}
